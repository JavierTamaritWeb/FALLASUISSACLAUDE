{
  "name": "web-falla",
  "version": "4.41.4",
  "description": "Proyecto Gulp para la Falla Suïssa - L'Alqueria del Favero",
  "main": "index.js",
  "scripts": {
    "dev": "gulp",
    "build": "gulp build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "git:check-large-files": "node scripts/check-git-file-size.mjs --scope=unpushed",
    "git:check-staged-large-files": "node scripts/check-git-file-size.mjs --scope=staged",
    "seo:dist": "gulp seoDist",
    "seo:schema-report": "node scripts/schema-report.mjs",
    "test:e2e": "playwright test -c playwright.smoke.config.js",
    "test:unit": "npm run lint:scss && node --test tests/unit/*.test.cjs && node scripts/search-eval.mjs",
    "audit:project": "npm run build && npm run lint:scss && npm run test:unit && npm run search:eval && npm run test:e2e:full -- --workers=4 && npm audit --audit-level=high",
    "test:e2e:full": "playwright test",
    "test:e2e:ui": "playwright test -c playwright.smoke.config.js --ui",
    "test:e2e:ui:full": "playwright test --ui",
    "test:e2e:visual": "playwright test tests/visual-regression.e2e.spec.js",
    "test:e2e:install": "playwright install",
    "generate:og": "node scripts/generate-og-image.mjs",
    "deploy": "bash tools/deploy.sh",
    "search:eval": "node scripts/search-eval.mjs",
    "seo:verify:production": "node scripts/verify-seo-production.mjs",
    "lint:scss": "node scripts/lint-scss.mjs",
    "lint:scss:baseline": "node scripts/lint-scss.mjs --update-baseline && node scripts/scss-baseline.mjs --update"
  },
  "author": "TuNombre",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.1.9",
    "glob": "^11.0.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-postcss": "^9.0.1",
    "gulp-sass": "^6.0.1",
    "gulp-terser": "^2.1.0",
    "postcss": "^8.4.49",
    "sass": "^1.85.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "keywords": [],
  "dependencies": {
    "flatpickr": "^4.6.13"
  },
  "browserslist": [
    "defaults",
    "iOS >= 15",
    "Safari >= 15"
  ]
}
