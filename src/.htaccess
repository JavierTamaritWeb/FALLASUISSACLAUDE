# Apache .htaccess para Falla Suïssa
# Configuración optimizada para performance y SEO
RewriteEngine On

# Forzar HTTPS y dominio canónico (sin www) en una sola redirección
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.fallasuissa\.es$ [NC]
RewriteRule ^ https://fallasuissa.es%{REQUEST_URI} [R=301,L]

# =======================================================================
# MODO MANTENIMIENTO
# =======================================================================
# Activo SOLO si existe el archivo centinela ".maintenance" en la raíz del
# servidor. Se enciende/apaga con `tools/deploy.sh --maintenance on|off`
# (sube/borra ese fichero por SSH) sin necesidad de re-desplegar.
#
# Devuelve HTTP 503 (Service Unavailable) + Retry-After para que Google NO
# indexe la pantalla ni piense que el contenido desapareció. La página servida
# (mantenimiento.html) es autocontenida (CSS inline, sin assets externos), por
# lo que no hace falta excluir CSS/JS/imágenes del rewrite.
#
# Bypass del equipo por TOKEN SECRETO (no por IP, para no versionar datos
# personales): visitar con ?preview=TOKEN fija una cookie de bypass y permite
# ver la web real. __MAINT_TOKEN__ es un placeholder: el valor real lo inyecta
# `tools/deploy.sh` tras el rsync, leyéndolo de tools/deploy.env (NO versionado).

# 1) Durante mantenimiento, si llega el token por query, fija la cookie de bypass
#    (válida 1 día) para que las siguientes peticiones (sin query) también pasen.
RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
RewriteCond %{QUERY_STRING} (^|&)preview=__MAINT_TOKEN__($|&)
RewriteRule ^ - [CO=maint_bypass:__MAINT_TOKEN__:.fallasuissa.es:1440:/]

# 2) Responder 503 salvo que: haya cookie de bypass, venga el token por query, o
#    sea la propia página de mantenimiento (evita el bucle 503).
RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
RewriteCond %{HTTP_COOKIE} !maint_bypass=__MAINT_TOKEN__
RewriteCond %{QUERY_STRING} !(^|&)preview=__MAINT_TOKEN__($|&)
RewriteCond %{REQUEST_URI} !=/mantenimiento.html
RewriteRule ^ - [R=503,L]

ErrorDocument 503 /mantenimiento.html
<IfModule mod_headers.c>
    # Retry-After solo se añade a las respuestas 503 del mantenimiento (2 horas).
    Header always set Retry-After "7200" "expr=%{REQUEST_STATUS} == 503"
</IfModule>


# =======================================================================
# COMPRESIÓN GZIP
# =======================================================================
<IfModule mod_deflate.c>
    # Comprimir HTML, CSS, JavaScript, Text, XML y fonts
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# =======================================================================
# CACHÉ DEL NAVEGADOR
# =======================================================================
<IfModule mod_expires.c>
    ExpiresActive on

    # Imágenes
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # CSS y JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fuentes
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Documentos
    ExpiresByType application/pdf "access plus 1 month"

    # HTML
    ExpiresByType text/html "access plus 1 week"
</IfModule>

# =======================================================================
# HEADERS DE SEGURIDAD Y CACHÉ FUERTE
# =======================================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|jpe?g|png|gif|svg|webp|avif|ico|woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Expires "0"
        Header set Pragma "no-cache"
    </Files>

    # Cabeceras de seguridad
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    # X-XSS-Protection eliminada (auditoría de seguridad jun-2026): obsoleta y potencialmente
    # perjudicial (Chrome la retiró, Firefox nunca la soportó). La defensa real
    # frente a XSS es la Content-Security-Policy de más abajo.

    # HSTS: tras la primera visita el navegador fuerza HTTPS por su cuenta,
    # evitando el SSL-stripping/MITM previo a la redirección 301 a HTTPS.
    # includeSubDomains + preload listos para enviar a https://hstspreload.org
    # (subir el max-age solo cuando se confirme que todo el dominio sirve HTTPS).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content-Security-Policy: defensa en profundidad. Restringe el origen de
    # scripts/estilos/conexiones a la allowlist real de CDNs y APIs del sitio,
    # de modo que un recurso inyectado desde un dominio no listado se bloquea.
    # 'unsafe-inline' es necesario por los <script>/onclick/style= inline ya
    # existentes (sitio estático sin pipeline de nonces); para endurecer en el
    # futuro, migrar esos inline a hashes o nonces y retirar 'unsafe-inline'.
    # Se emite por CABECERA HTTP (no por <meta>) para no romper el iframe de
    # Google Drive en nuevos-falleros.html (ver restricción en CLAUDE.md).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://*.basemaps.cartocdn.com https://openweathermap.org https://*.openweathermap.org; connect-src 'self' https://api.openweathermap.org https://api.emailjs.com; frame-src https://drive.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # =======================================================================
    # AGENT-READY: Link headers (RFC 8288) en respuestas HTML
    # Una directiva por relación (Apache las une con ", " al enviar) para
    # evitar el escape \"..\" que rompe parsers RFC 8288 estrictos.
    # rel sin comillas (válido per §3 cuando es un único relation-type token).
    # =======================================================================
    <FilesMatch "\.html$">
        Header always set    Link "</.well-known/api-catalog>; rel=api-catalog"
        Header always append Link "</.well-known/agent-skills/index.json>; rel=agent-skills"
        Header always append Link "</ai-discovery.json>; rel=describedby"
        Header always append Link "</ai-discovery.json>; rel=service-desc"
        Header always append Link "</seo/ai-training-data.md>; rel=alternate"
        Header always append Link "</sitemap-index.xml>; rel=sitemap"
    </FilesMatch>

    # Content-Type para Markdown (negociación de contenido text/markdown)
    <FilesMatch "\.md$">
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Vary "Accept"
    </FilesMatch>
</IfModule>

# =======================================================================
# AGENT-READY: MIME para /.well-known/api-catalog (RFC 9727, sin extensión)
# =======================================================================
<Files "api-catalog">
    ForceType application/linkset+json
</Files>

# =======================================================================
# REDIRECCIONES Y URLs AMIGABLES
# =======================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Redirección www a no-www
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # =======================================================================
    # REDIRECCIONES 301/410 — Limpieza de URLs 404 detectadas por GSC
    # =======================================================================

    # A) Google indexó variantes /va/pdf/* que nunca existieron (los PDFs
    #    solo viven en /pdf/*). Redirigir a la versión real.
    RewriteRule ^va/pdf/(.*)$ /pdf/$1 [R=301,L]

    # A2) Red de seguridad: el HTML /va/ anterior a v4.7.9 referenciaba los
    #     assets con rutas relativas que resolvían a /va/css|js|img|data
    #     (inexistentes -> 404). El build ya escribe rutas absolutas, pero el
    #     HTML cacheado/indexado sigue pidiendo estas URLs.
    RewriteRule ^va/(css|js|img|data|favicon_io)/(.*)$ /$1/$2 [R=301,L]

    # B) PDFs "Mig Any 2025" eliminados sin equivalente actual -> 410 Gone
    #    (avisa a Google de que se fueron permanentemente)
    RewriteRule ^pdf/migany2025.*\.pdf$ - [R=410,L]

    # C) Llibret 2024 movido de /pdf/ a /pdf/Llibrets/
    #    El % va escapado (\%): en la sustitución de mod_rewrite un % sin
    #    escapar es un backreference de RewriteCond (%2 → cadena vacía) y el
    #    301 apuntaba a ...FALLA0_MORERES... (otro 404).
    RewriteRule "^pdf/2024_LLIBRET_FALLA._MORERES_DIGITAL\.pdf$" "/pdf/Llibrets/2024_LLIBRET_FALLA\%20_MORERES_DIGITAL.pdf" [R=301,L]

    # D) Bases campeonatos JCF temporada anterior (códigos C6xxx) ->
    #    /deportes.html (nuevas bases 2026-27 enlazadas desde el tablón)
    RewriteRule "^pdf/C6[0-9]+.*\.pdf$" /deportes.html [R=301,L]

    # E) base.html era una plantilla interna publicada por error (indexable y
    #    sin entrada en sitemap); desde v4.7.9 se excluye del build -> 410 Gone
    RewriteRule ^(va/)?base\.html$ - [R=410,L]

    # Negociación de contenido Markdown (RFC 7231)
    # Si un agente solicita Accept: text/markdown sobre /, servir resumen .md
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^$ /seo/ai-training-data.md [L]

    # Si existe versión .md junto al .html, servirla cuando se pide markdown
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.md -f
    RewriteRule ^(.*)$ $1.md [L]

    # Añadir .html si no existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# =======================================================================
# TIPOS MIME PARA NUEVOS FORMATOS
# =======================================================================
<IfModule mod_mime.c>
    # Imágenes modernas
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType image/avif .avif
    AddType video/mp4 .mp4 .m4v
    
    # Fuentes
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    
    # Manifesto
    AddType application/manifest+json .webmanifest
</IfModule>

# =======================================================================
# PROTECCIÓN DE ARCHIVOS SENSIBLES
# =======================================================================
<Files ".htaccess">
    Require all denied
</Files>

<Files "*.json">
    <RequireAll>
        Require all granted
    </RequireAll>
</Files>

# Proteger archivos de configuración
<FilesMatch "^(gulpfile|package|\.git)">
    Require all denied
</FilesMatch>
