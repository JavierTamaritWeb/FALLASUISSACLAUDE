# Plantilla de configuración del deploy.
# Copia este archivo a "deploy.env" (mismo directorio) y rellena los valores reales.
# deploy.env está en .gitignore y NUNCA debe subirse al repositorio.
SSH_USER=
SSH_HOST=
SSH_PORT=65002
REMOTE_DIR=domains/tu-dominio.es/public_html
# Token secreto para el bypass del modo mantenimiento. Genera uno con:
#   openssl rand -hex 16
MAINT_TOKEN=
